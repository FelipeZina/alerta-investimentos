# Copie este arquivo para .env e preencha com seus valores reais.
# O .env está no .gitignore e não vai para o GitHub.

# Token da brapi (crie em https://brapi.dev/dashboard)
BRAPI_TOKEN=

# Bot do Telegram (crie com o @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Postgres (Neon) - formato: postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL=

# Variação % (para cima ou para baixo) que dispara alerta
ALERT_THRESHOLD_PCT=3
